{
  "name": "chandrabhar-2-web",
  "version": "3.0.0",
  "private": true,
  "description": "CHANDRABHAR-2 browser-native lunar image-registration workspace (Python engine running in WebAssembly)",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/build-engine-bundle.mjs && vite",
    "build": "node scripts/build-engine-bundle.mjs && node scripts/check-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:py": "python -m pytest -q",
    "test:e2e": "node tests-e2e/run.mjs",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "fixtures": "python tools/make_fixtures.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^138.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
